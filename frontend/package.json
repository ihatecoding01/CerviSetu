{
  "name": "cervisetu",
  "private": false,
  "version": "0.0.1",
  "description": "CerviSetu — Real-time rural cancer patient tracking, escalation heatmaps, and ASHA coordination platform",
  "homepage": "https://github.com/ohcnetwork/care",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:cf": "tsc -b && vite build --mode cloudflare",
    "deploy:cf": "npx wrangler pages deploy dist --project-name cervisetu",
    "start": "vite preview",
    "preview": "vite preview",
    "lint": "oxlint"
  },
  "keywords": [
    "care",
    "ohc",
    "health",
    "rural",
    "asha",
    "cancer",
    "plugin"
  ],
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
