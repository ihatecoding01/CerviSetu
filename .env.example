# ==========================================
# CerviSetu Sovereign Oncology AI System Env
# ==========================================

# Groq API Key (High-Speed Oncology Inference)
# Recommended model: llama-3.3-70b-versatile or llama-3.1-8b-instant
GROQ_API_KEY=
GROQ_MODEL="llama-3.3-70b-versatile"

# Sarvam AI API Key (Indic Clinical Speech TTS, ASR & Vision)
# Get from: https://dashboard.sarvam.ai/
SARVAM_API_KEY=
SARVAM_BASE_URL="https://api.sarvam.ai"
SARVAM_TTS_MODEL="bulbul:v4-flash"

# Optional Model Fallbacks
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# LangSmith Tracing & Observability (Optional)
# Set LANGCHAIN_TRACING_V2=false to disable offline timeouts
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="cervisetu-oncology"

# Security Vault Key (32-byte Base64 key for AES-256 PII token encryption)
# Leave blank to use auto-generated default local dev key
VAULT_SECRET_KEY=

# Supabase Production PostgreSQL Database Configuration
# Get from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
# Direct PostgreSQL connection string (pooled port 6543 or direct port 5432)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Cloudflare Pages Hosting Configuration
# Get from: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id



